{
  "name": "vscode-problems-cleaner",
  "displayName": "Problems Cleaner",
  "description": "Refresh stale VS Code Problems diagnostics, restart stuck diagnostic providers, and hide obsolete entries caused by stale lint/task extensions.",
  "version": "0.2.0",
  "publisher": "VladNoskov",
  "license": "MIT",
  "icon": "resources/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/vladnoskv/ClearProblems.git"
  },
  "bugs": {
    "url": "https://github.com/vladnoskv/ClearProblems/issues"
  },
  "homepage": "https://github.com/vladnoskv/ClearProblems#readme",
  "galleryBanner": {
    "color": "#0f172a",
    "theme": "dark"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other",
    "Linters"
  ],
  "keywords": [
    "problems",
    "diagnostics",
    "lint",
    "stale",
    "refresh",
    "eslint",
    "typescript"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "problemsCleaner.refreshProblems",
        "title": "Problems Cleaner: Refresh Problems",
        "category": "Problems Cleaner",
        "icon": {
          "light": "resources/icons/problems-cleaner-light.png",
          "dark": "resources/icons/problems-cleaner-dark.png"
        }
      },
      {
        "command": "problemsCleaner.hardRefreshProblems",
        "title": "Problems Cleaner: Restart Extension Host (Hard Refresh)",
        "category": "Problems Cleaner",
        "icon": {
          "light": "resources/icons/problems-cleaner-light.png",
          "dark": "resources/icons/problems-cleaner-dark.png"
        }
      },
      {
        "command": "problemsCleaner.cancelOperation",
        "title": "Problems Cleaner: Cancel Operation",
        "category": "Problems Cleaner",
        "icon": {
          "light": "resources/icons/problems-cleaner-light.png",
          "dark": "resources/icons/problems-cleaner-dark.png"
        }
      },
      {
        "command": "problemsCleaner.showDiagnosticsReport",
        "title": "Problems Cleaner: Show Diagnostics Report",
        "category": "Problems Cleaner",
        "icon": {
          "light": "resources/icons/problems-cleaner-light.png",
          "dark": "resources/icons/problems-cleaner-dark.png"
        }
      },
      {
        "command": "problemsCleaner.copyAllProblems",
        "title": "Problems Cleaner: Copy All Problems",
        "category": "Problems Cleaner",
        "icon": {
          "light": "resources/icons/problems-cleaner-light.png",
          "dark": "resources/icons/problems-cleaner-dark.png"
        }
      },
      {
        "command": "problemsCleaner.setup",
        "title": "Problems Cleaner: Scan Diagnostic Providers",
        "category": "Problems Cleaner",
        "icon": {
          "light": "resources/icons/problems-cleaner-light.png",
          "dark": "resources/icons/problems-cleaner-dark.png"
        }
      },
      {
        "command": "problemsCleaner.manageExtensions",
        "title": "Problems Cleaner: Open Dashboard",
        "category": "Problems Cleaner",
        "icon": {
          "light": "resources/icons/problems-cleaner-light.png",
          "dark": "resources/icons/problems-cleaner-dark.png"
        }
      },
      {
        "command": "problemsCleaner.addExtensionFromContext",
        "title": "Problems Cleaner: Add to Problems Refresh",
        "category": "Problems Cleaner",
        "icon": {
          "light": "resources/icons/problems-cleaner-light.png",
          "dark": "resources/icons/problems-cleaner-dark.png"
        }
      },
      {
        "command": "problemsCleaner.refreshProviderFromProblem",
        "title": "Problems Cleaner: Refresh Provider for Problem",
        "category": "Problems Cleaner",
        "icon": {
          "light": "resources/icons/problems-cleaner-light.png",
          "dark": "resources/icons/problems-cleaner-dark.png"
        }
      },
      {
        "command": "problemsCleaner.hardRefreshProviderFromProblem",
        "title": "Problems Cleaner: Restart Extension Host for Provider",
        "category": "Problems Cleaner",
        "icon": {
          "light": "resources/icons/problems-cleaner-light.png",
          "dark": "resources/icons/problems-cleaner-dark.png"
        }
      },
      {
        "command": "problemsCleaner.clearProblems",
        "title": "Problems Cleaner: Clear Allowed Task Problems",
        "category": "Problems Cleaner",
        "icon": {
          "light": "resources/icons/problems-cleaner-light.png",
          "dark": "resources/icons/problems-cleaner-dark.png"
        }
      },
      {
        "command": "problemsCleaner.openSettings",
        "title": "Problems Cleaner: Settings",
        "category": "Problems Cleaner",
        "icon": {
          "light": "resources/icons/problems-cleaner-light.png",
          "dark": "resources/icons/problems-cleaner-dark.png"
        }
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "problemsCleaner",
          "title": "Problems Cleaner",
          "icon": "resources/problems-cleaner.svg"
        }
      ]
    },
    "views": {
      "problemsCleaner": [
        {
          "id": "problemsCleaner.dashboard",
          "name": "Problems Cleaner",
          "icon": "resources/problems-cleaner.svg",
          "type": "webview"
        }
      ]
    },
    "menus": {
      "commandPalette": [
        {
          "command": "problemsCleaner.refreshProblems"
        },
        {
          "command": "problemsCleaner.hardRefreshProblems"
        },
        {
          "command": "problemsCleaner.cancelOperation",
          "when": "false"
        },
        {
          "command": "problemsCleaner.showDiagnosticsReport"
        },
        {
          "command": "problemsCleaner.copyAllProblems"
        },
        {
          "command": "problemsCleaner.setup"
        },
        {
          "command": "problemsCleaner.manageExtensions"
        },
        {
          "command": "problemsCleaner.refreshProviderFromProblem"
        },
        {
          "command": "problemsCleaner.hardRefreshProviderFromProblem"
        },
        {
          "command": "problemsCleaner.clearProblems"
        },
        {
          "command": "problemsCleaner.openSettings"
        }
      ],
      "extension/context": [
        {
          "command": "problemsCleaner.addExtensionFromContext",
          "group": "2_configure@90"
        }
      ],
      "editor/context": [
        {
          "command": "problemsCleaner.refreshProviderFromProblem",
          "when": "resourceScheme == file",
          "group": "navigation@98"
        },
        {
          "command": "problemsCleaner.hardRefreshProviderFromProblem",
          "when": "resourceScheme == file",
          "group": "navigation@99"
        }
      ],
      "view/title": [
        {
          "command": "problemsCleaner.refreshProblems",
          "when": "view == workbench.panel.markers.view || view == problemsCleaner.dashboard",
          "group": "navigation@100"
        },
        {
          "command": "problemsCleaner.showDiagnosticsReport",
          "when": "view == problemsCleaner.dashboard",
          "group": "navigation@101"
        },
        {
          "command": "problemsCleaner.copyAllProblems",
          "when": "view == workbench.panel.markers.view || view == problemsCleaner.dashboard",
          "group": "navigation@101"
        },
        {
          "command": "problemsCleaner.manageExtensions",
          "when": "view == problemsCleaner.dashboard",
          "group": "navigation@102"
        },
        {
          "command": "problemsCleaner.hardRefreshProblems",
          "when": "view == workbench.panel.markers.view || view == problemsCleaner.dashboard",
          "group": "navigation@103"
        },
        {
          "command": "problemsCleaner.clearProblems",
          "when": "view == workbench.panel.markers.view || view == problemsCleaner.dashboard",
          "group": "navigation@104"
        },
        {
          "command": "problemsCleaner.openSettings",
          "when": "view == problemsCleaner.dashboard",
          "group": "navigation@105"
        }
      ]
    },
    "configuration": {
      "title": "Problems Cleaner",
      "properties": {
        "problemsCleaner.saveAllBeforeRefresh": {
          "type": "boolean",
          "default": false,
          "order": 1,
          "markdownDescription": "Save all open files before running refresh commands."
        },
        "problemsCleaner.openProblemsAfterRefresh": {
          "type": "boolean",
          "default": false,
          "order": 2,
          "markdownDescription": "Open and focus the Problems panel after a manual refresh. Disabled by default so refresh does not steal focus."
        },
        "problemsCleaner.showSetupOnFirstInstall": {
          "type": "boolean",
          "default": false,
          "order": 3,
          "markdownDescription": "Prompt to scan installed extensions and configure diagnostic providers the first time Problems Cleaner activates. Disabled by default so activation does not open setup UI."
        },
        "problemsCleaner.providerRefreshCommands": {
          "type": "array",
          "default": [],
          "items": {
            "type": "string"
          },
          "order": 10,
          "markdownDescription": "Opt-in command IDs for **Refresh Problems**. Commands run only when their provider matches a current diagnostic source unless refreshOnlyRelevantProviders is disabled. Add language/linter refresh commands here."
        },
        "problemsCleaner.refreshOnlyRelevantProviders": {
          "type": "boolean",
          "default": true,
          "order": 11,
          "markdownDescription": "Only run configured provider commands whose provider matches a current diagnostic source. Recommended to prevent unrelated extensions from restarting or making requests."
        },
        "problemsCleaner.refreshTasks": {
          "type": "boolean",
          "default": false,
          "order": 20,
          "markdownDescription": "Re-execute workspace tasks whose `problemMatchers` generated current diagnostics during **Refresh Problems**. When a task runs again, VS Code clears old task-owned diagnostics and republishes fresh ones — fixing duplicate/stale problems caused by line shifts after edits. Leave disabled if you don't want tasks re-run automatically during refresh."
        },
        "problemsCleaner.clearedTasks": {
          "type": "array",
          "default": [],
          "items": {
            "type": "string"
          },
          "order": 21,
          "markdownDescription": "Task names (exact labels from `tasks.json`) that **Clear Problems** is allowed to terminate and restart. When Clear Problems runs, only tasks whose name appears in this list will be killed and re-executed. Leave empty to prevent Clear Problems from restarting any tasks – it will still show matching tasks in the dashboard.\n\nExample: `[\"tsc: watch - tsconfig.json\", \"eslint: whole folder\"]`"
        },
        "problemsCleaner.hardRefreshMode": {
          "type": "string",
          "enum": [
            "restartExtensionHost",
            "reloadWindow"
          ],
          "markdownEnumDescriptions": [
            "Restart the VS Code Extension Host. Less disruptive; clears most stuck diagnostics without reloading the window.",
            "Reload the entire VS Code window. Fallback when the Extension Host restart is not enough."
          ],
          "default": "restartExtensionHost",
          "order": 30,
          "markdownDescription": "Hard refresh strategy for **Hard Refresh Problems**. Restart Extension Host is less disruptive than Reload Window when supported."
        },
        "problemsCleaner.showStatusBarButton": {
          "type": "boolean",
          "default": true,
          "order": 40,
          "markdownDescription": "Show the Problems Cleaner button in the VS Code status bar for quick access to refresh, report, and settings."
        },
        "problemsCleaner.backgroundTaskWaitMs": {
          "type": "integer",
          "default": 8000,
          "minimum": 1000,
          "maximum": 60000,
          "order": 50,
          "markdownDescription": "How long (in milliseconds) to wait for a background/watch task to publish diagnostics after being restarted. Increase if your build system takes longer to produce initial output."
        },
        "problemsCleaner.taskExecutionTimeoutMs": {
          "type": "integer",
          "default": 120000,
          "minimum": 5000,
          "maximum": 600000,
          "order": 51,
          "markdownDescription": "Maximum time (in milliseconds) to wait for a non-background task to finish executing during Clear Problems or Refresh Problems. If the task doesn't complete within this time, it is treated as timed out and execution continues."
        }
      }
    }
  },
  "scripts": {
    "clean": "node -e \"require('fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "vscode:prepublish": "npm run compile",
    "package": "npm run vsix",
    "vsix": "npm run clean && npm run compile && vsce package --no-dependencies --out dist/vscode-problems-cleaner.vsix",
    "publish:dry-run": "npm run vsix && vsce ls --tree --no-dependencies"
  },
  "devDependencies": {
    "@types/node": "^20.14.10",
    "@types/vscode": "^1.90.0",
    "typescript": "^5.6.3",
    "@vscode/vsce": "^3.2.1"
  }
}
